      "case_id": "CASE_01_DENGUE",
      "case_type": "ordinary",
      "protocol": "Dengue",
      "patient_text": "A 24-year-old patient has high fever for 3 days, severe headache, pain behind the eyes, body ache and rash. No vomiting, bleeding or altered consciousness is reported.",
      "expected_checklist": {
        "probable_diagnosis": "Dengue",
        "should_retrieve_diagnosis_card": true,
